# Copy to .env and fill locally. NEVER commit a filled copy; production values live
# in the deploy host's secret manager, not in this repo and not in any image layer.

# --- public identity -------------------------------------------------------
PROVIDENCE_HOSTNAME=providence.example.test
PROVIDENCE_BASE_URL=https://providence.example.test

# --- database --------------------------------------------------------------
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=providence
MYSQL_USER=providence
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- first-boot install ----------------------------------------------------
# Applied ONCE, by the entrypoint, only when the schema is absent.
# Profile is a filename in install/profiles/xml minus .xml. Shipped at 2.0.11:
# base, default, cdwalite, dacs, darwincore, dublincore_qualif_2018, ebucore,
# isad_g, maxwell, pbcore, pp5_complete, testing, ummaa-lsa, vracore.
CA_INSTALL_PROFILE=base
CA_ADMIN_EMAIL=
# NOTE: `caUtils install` has NO --admin-password option (verified at the pinned
# commit). Set the admin password out of band after the first install.

# --- auth ------------------------------------------------------------------
# CaUsers is Providence's own login and is the only supported value today.
# HTTPHeader is the trusted-header adapter the future BOS gateway will use; do
# NOT set it until that gateway exists, or anyone who can reach php-fpm is admin.
CA_AUTH_ADAPTER=CaUsers

# Schema migration is an operator step, not a boot step. See docs/upgrade.md.
CA_AUTO_MIGRATE=0

# --- runtime ---------------------------------------------------------------
PHP_MEMORY_LIMIT=512M
PHP_UPLOAD_MAX_FILESIZE=2G
PHP_POST_MAX_SIZE=2G
