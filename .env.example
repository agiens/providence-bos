# Copy to .env and fill locally. NEVER commit a filled copy; production values live
# in the deploy host's secret manager, not in this repo and not in any image layer.

# --- public identity -------------------------------------------------------
PROVIDENCE_HOSTNAME=providence.example.test
PROVIDENCE_BASE_URL=https://providence.example.test

# --- database --------------------------------------------------------------
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=providence
MYSQL_USER=providence
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- first-boot install ----------------------------------------------------
# Applied ONCE, by the entrypoint, only when the schema is absent.
CA_INSTALL_PROFILE=base
CA_ADMIN_EMAIL=
CA_ADMIN_PASSWORD=

# --- runtime ---------------------------------------------------------------
PHP_MEMORY_LIMIT=512M
PHP_UPLOAD_MAX_FILESIZE=2G
PHP_POST_MAX_SIZE=2G
